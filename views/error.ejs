<% layout("layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-6 offset-3">
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading">Error <%= err.statusCode || 500 %>!</h4>
      <p><%= err.message || "Something went wrong." %></p>
      <hr>
      <a href="/listings" class="btn btn-dark mt-2">Go Back Home</a>
    </div>
  </div>
</div>
